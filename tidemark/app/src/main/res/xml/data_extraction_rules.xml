<?xml version="1.0" encoding="utf-8"?>
<!-- Local-first: nothing leaves the phone. Secrets are bound to this phone's Keystore, so the database and
     the WebView session must not be copied to another device either. Use Settings > Export instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
